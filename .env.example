# MongoDB connection string for Payload (mongooseAdapter).
# MONGODB_URI is accepted as a fallback if DATABASE_URI is unset.
DATABASE_URI=mongodb://127.0.0.1/portfolio

# Random secret used to sign Payload cookies and tokens. Generate a long random string.
PAYLOAD_SECRET=CHANGE_ME

# Cloudinary (plugin not wired yet — Media uploads locally until credentials exist).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
